{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "custom-agent.input.v1",
  "title": "Custom Agent \u2014 Generic Input Contract (v1)",
  "description": "Flexible input contract for user-defined custom subagents. No stage_id const \u2014 use any agent name. No strict validation \u2014 the agent defines its own expectations.",
  "type": "object",
  "required": [
    "run_id",
    "agent_name",
    "user_request"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Current run identifier"
    },
    "agent_name": {
      "type": "string",
      "description": "Agent filename stem (matches the .md file in agents/)"
    },
    "user_request": {
      "type": "string",
      "minLength": 1,
      "description": "What to do"
    },
    "context": {
      "type": "object",
      "description": "Any context the custom agent needs. Passed through as-is.",
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths to prior output artifacts the agent should read",
      "default": []
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional constraints (e.g. 'read-only', 'no file edits')",
      "default": []
    },
    "model_override": {
      "type": "string",
      "description": "Model to use. Falls back to tool default."
    },
    "context_snapshot": {
      "type": "object",
      "description": "Condensed historical context injected by the orchestrator before each stage spawn. See shared/context-snapshot.v1.json for schema.",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "depth": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "comprehensive"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "project_context": {
          "type": "object"
        },
        "current_state": {
          "type": "object"
        },
        "recent_decisions": {
          "type": "array"
        },
        "stage_timeline": {
          "type": "array"
        },
        "open_items": {
          "type": "object"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recent_handoffs": {
          "type": "array"
        },
        "markdown": {
          "type": "string",
          "description": "Full markdown representation of the snapshot"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}