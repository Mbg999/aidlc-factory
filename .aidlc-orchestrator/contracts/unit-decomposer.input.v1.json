{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "unit-decomposer.input.v1",
  "title": "Unit Decomposer \u2014 Input Contract (v1)",
  "description": "Input contract for the Unit Decomposer stage. Receives the execution plan with units and decomposes them into per-unit specs with dependencies.",
  "type": "object",
  "required": [
    "run_id",
    "stage_id",
    "user_request",
    "predecessor_artifacts",
    "units",
    "skills_required",
    "skill_paths_resolved"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "stage_id": {
      "const": "unit-decomposer"
    },
    "user_request": {
      "type": "string",
      "minLength": 1
    },
    "predecessor_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Must include execution-plan.md"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "minItems": 1,
      "description": "Copied from workflow-planner output"
    },
    "skills_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "default": [
        "using-agent-skills",
        "planning-and-task-breakdown"
      ]
    },
    "skill_paths_resolved": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "budget": {
      "type": "object"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "require_human_approval"
      ]
    },
    "context_pointers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "locks_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "model_override": {
      "type": "string",
      "description": "Model to use for this stage. Overrides tool default. Set by orchestrator from budgets/default.yaml."
    },
    "context_snapshot": {
      "type": "object",
      "description": "Condensed historical context injected by the orchestrator before each stage spawn. See shared/context-snapshot.v1.json for schema.",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "depth": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "comprehensive"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "project_context": {
          "type": "object"
        },
        "current_state": {
          "type": "object"
        },
        "recent_decisions": {
          "type": "array"
        },
        "stage_timeline": {
          "type": "array"
        },
        "open_items": {
          "type": "object"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recent_handoffs": {
          "type": "array"
        },
        "markdown": {
          "type": "string",
          "description": "Full markdown representation of the snapshot"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}