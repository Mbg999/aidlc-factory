{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workspace-scout.input.v1",
  "title": "Workspace Scout \u2014 Input Contract (v1)",
  "description": "Input contract for the Workspace Scout stage. Receives the raw user request and detects greenfield vs brownfield state, tech stack, and workspace structure.",
  "type": "object",
  "required": [
    "run_id",
    "stage_id",
    "user_request",
    "skills_required",
    "skill_paths_resolved"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+$",
      "description": "Lower-kebab run identifier, e.g. 2026-05-08T14-23-00Z-auth-rewrite"
    },
    "stage_id": {
      "const": "workspace-scout"
    },
    "user_request": {
      "type": "string",
      "minLength": 1,
      "description": "Raw user request, logged verbatim to audit.md"
    },
    "predecessor_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "skills_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Workspace Scout requires no Define/Build skills, only the implicit using-agent-skills.",
      "default": [
        "using-agent-skills"
      ]
    },
    "skill_paths_resolved": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Orchestrator-resolved paths to SKILL.md files"
    },
    "budget": {
      "type": "object",
      "properties": {
        "tokens_max": {
          "type": "integer",
          "minimum": 1
        },
        "wall_clock_max_min": {
          "type": "number",
          "minimum": 0
        },
        "retries_max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "context_pointers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "locks_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "model_override": {
      "type": "string",
      "description": "Model to use for this stage. Overrides tool default. Set by orchestrator from budgets/default.yaml."
    },
    "context_snapshot": {
      "type": "object",
      "description": "Condensed historical context injected by the orchestrator before each stage spawn. See shared/context-snapshot.v1.json for schema.",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "depth": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "comprehensive"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "project_context": {
          "type": "object"
        },
        "current_state": {
          "type": "object"
        },
        "recent_decisions": {
          "type": "array"
        },
        "stage_timeline": {
          "type": "array"
        },
        "open_items": {
          "type": "object"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recent_handoffs": {
          "type": "array"
        },
        "markdown": {
          "type": "string",
          "description": "Full markdown representation of the snapshot"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}