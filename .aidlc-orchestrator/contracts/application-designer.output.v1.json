{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "application-designer.output.v1",
  "title": "Application Designer — Output Contract (v1)",
  "type": "object",
  "required": ["status", "run_id", "stage_id", "artifacts", "audit_entries", "skill_compliance"],
  "properties": {
    "status": { "type": "string", "enum": ["complete", "needs_human", "failed", "blocked"] },
    "run_id": { "type": "string" },
    "stage_id": { "const": "application-designer" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string", "enum": ["doc", "design", "questions"] },
          "hash": { "type": "string" }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "audit_entries": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "skill_compliance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "status", "evidence"],
        "properties": {
          "skill": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "N/A"] },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "minItems": 2
    },
    "cost": {
      "type": "object",
      "properties": {
        "tokens_in": { "type": "integer", "minimum": 0 },
        "tokens_out": { "type": "integer", "minimum": 0 },
        "wall_clock_min": { "type": "number", "minimum": 0 },
        "retries_used": { "type": "integer", "minimum": 0 }
      }
    },
    "emitted_knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "title", "body"],
        "properties": {
          "kind": { "type": "string", "enum": ["pattern", "adr", "antipattern", "lesson", "drift_baseline_updated"] },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
          "related_artifacts": { "type": "array", "items": { "type": "string" }, "default": [] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "context_pointers": { "type": "array", "items": { "type": "string" }, "default": [] },
    "needs_user_input": { "type": "boolean", "default": false },
    "questions_artifact_path": { "type": "string" },
    "conflicts_detected": { "type": "array", "default": [] },
    "locks_to_release": { "type": "array", "items": { "type": "string" }, "default": [] }
  },
  "additionalProperties": false
}
