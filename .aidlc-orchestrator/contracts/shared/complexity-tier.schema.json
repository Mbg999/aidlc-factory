{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shared/complexity-tier.v1",
  "title": "Complexity Tier — Manifest Fragment Schema (v1)",
  "description": "Validates the manifest fields written by factory_complexity.py. All requests use the same full routing — no tier system.",
  "type": "object",
  "required": ["complexity_tier"],
  "properties": {
    "complexity_tier": {
      "type": "string",
      "const": "LARGE",
      "description": "Always LARGE — every request runs the full pipeline."
    },
    "skip_stages": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "maxItems": 0
    },
    "merge_codegen_gate": {
      "type": "boolean",
      "const": false
    },
    "reviewer_pool": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "reviewer-code",
          "reviewer-security",
          "reviewer-performance",
          "reviewer-simplifier"
        ]
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
