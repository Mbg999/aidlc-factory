{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shared.context-snapshot.v1",
  "title": "Shared — Context Snapshot (v1)",
  "description": "Reusable context snapshot schema for all stage input contracts. Provides historical context from traceability files (audit.md, state, manifest, timeline, handoffs).",
  "type": "object",
  "properties": {
    "context_snapshot": {
      "type": "object",
      "description": "Condensed historical context injected by the orchestrator before each stage spawn. Prevents agents from working without awareness of prior decisions.",
      "properties": {
        "run_id": {
          "type": "string",
          "description": "Run identifier"
        },
        "depth": {
          "type": "string",
          "enum": ["minimal", "standard", "comprehensive"],
          "description": "Snapshot depth level"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the snapshot was generated"
        },
        "project_context": {
          "type": "object",
          "properties": {
            "project_slug": { "type": "string" },
            "orchestrator_version": { "type": "string" },
            "started_at": { "type": "string", "format": "date-time" },
            "profile": {
              "type": "object",
              "properties": {
                "ui": { "type": "boolean" },
                "api": { "type": "boolean" },
                "has_legacy": { "type": "boolean" },
                "framework": { "type": "string" }
              }
            }
          }
        },
        "current_state": {
          "type": "object",
          "properties": {
            "stage": { "type": "string" },
            "phase": { "type": "string" },
            "completed_stages": {
              "type": "array",
              "items": { "type": "string" }
            },
            "skipped_stages": {
              "type": "array",
              "items": { "type": "string" }
            },
            "failed_stages": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "recent_decisions": {
          "type": "array",
          "description": "Last N decision events from audit.md",
          "items": {
            "type": "object",
            "properties": {
              "ts": { "type": "string", "format": "date-time" },
              "phase": { "type": "string" },
              "label": { "type": "string" },
              "bullets": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "stage_timeline": {
          "type": "array",
          "description": "Per-stage event summary from timeline.jsonl",
          "items": {
            "type": "object",
            "properties": {
              "stage": { "type": "string" },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ts": { "type": "string" },
                    "evt": { "type": "string" },
                    "details": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "open_items": {
          "type": "object",
          "properties": {
            "incomplete_units": { "type": "integer" },
            "pending_approvals": { "type": "integer" },
            "items": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Resolved skill paths from manifest"
        },
        "recent_handoffs": {
          "type": "array",
          "description": "Last N output handoff statuses (comprehensive only)",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string" },
              "stage": { "type": "string" }
            }
          }
        },
        "markdown": {
          "type": "string",
          "description": "Full markdown representation of the snapshot (as generated by factory_context_builder.py). This is the primary field agents should read."
        }
      },
      "additionalProperties": false
    }
  }
}
