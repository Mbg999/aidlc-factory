{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reverse-engineer.input.v1",
  "title": "Reverse Engineer \u2014 Input Contract (v1)",
  "description": "Input contract for the Reverse Engineer stage. Receives workspace state for brownfield codebases to produce architecture docs, component inventory, and dependency graphs.",
  "type": "object",
  "required": [
    "run_id",
    "stage_id",
    "user_request",
    "predecessor_artifacts",
    "workspace_state",
    "skills_required",
    "skill_paths_resolved"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "stage_id": {
      "const": "reverse-engineer"
    },
    "user_request": {
      "type": "string",
      "minLength": 1
    },
    "predecessor_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "workspace_state": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "project_type": {
          "type": "string",
          "description": "Type of project (greenfield, legacy, monorepo, etc.)"
        },
        "existing_code": {
          "type": "boolean",
          "description": "Whether existing code was detected in the workspace"
        },
        "next_phase": {
          "type": "string",
          "description": "Next phase recommendation from workspace-scout"
        },
        "tech_stack_summary": {
          "type": "string",
          "description": "Detected technology stack summary"
        },
        "legacy_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Patterns detected in legacy code"
        }
      },
      "description": "Workspace state snapshot, sourced from workspace-scout output"
    },
    "skills_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "default": [
        "using-agent-skills"
      ]
    },
    "skill_paths_resolved": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "budget": {
      "type": "object"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "context_pointers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "locks_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "model_override": {
      "type": "string",
      "description": "Model to use for this stage. Overrides tool default. Set by orchestrator from budgets/default.yaml."
    },
    "context_snapshot": {
      "type": "object",
      "description": "Condensed historical context injected by the orchestrator before each stage spawn. See shared/context-snapshot.v1.json for schema.",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "depth": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "comprehensive"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "project_context": {
          "type": "object"
        },
        "current_state": {
          "type": "object"
        },
        "recent_decisions": {
          "type": "array"
        },
        "stage_timeline": {
          "type": "array"
        },
        "open_items": {
          "type": "object"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recent_handoffs": {
          "type": "array"
        },
        "markdown": {
          "type": "string",
          "description": "Full markdown representation of the snapshot"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}