# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SITE_URL: Public URL of the documentation site.
# Used for canonical URLs, sitemap, Open Graph images, and GEO/llms.txt references.
VITE_SITE_URL="https://mbg999.github.io/aidlc-factory"
